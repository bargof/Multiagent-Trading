# Copia este archivo a .env y escribe tu key. .env está en .gitignore y nunca
# entra al ZIP de entrega. También puedes definir la variable en el sistema.

# Obligatoria (decisión D47): una key de la API de Gemini, creada en Google
# AI Studio. La usan los agentes A0–A4 y el juez J1/J2.
GOOGLE_API_KEY=

# Opcionales. Cambiar los modelos es cambiar la campaña: entran en sus huellas.
# MODEL_NAME=gemini-3.6-flash
# JUDGE_MODEL=gemini-3.8-flash
# Llamadas por minuto por modelo. Ajústalo al límite que AI Studio muestra
# para tu proyecto; solo cambia el ritmo, no la campaña.
# GEMINI_RPM=8
