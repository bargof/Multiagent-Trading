# Copia este archivo a .env y escribe tus keys. .env está en .gitignore y nunca
# entra al ZIP de entrega. También puedes definir las variables en el sistema.

# Obligatorias, una por proveedor (decisión D22).
# Agentes A0–A4:
OPENAI_API_KEY=
# Juez J1 y J2:
ANTHROPIC_API_KEY=

# Opcionales. Cambiarlas es cambiar la campaña: se registran en sus huellas.
# MODEL_NAME=gpt-4.1-mini
# JUDGE_MODEL=claude-sonnet-5-5
